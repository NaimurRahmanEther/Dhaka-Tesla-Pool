# Copy to `.env.local` and change this only if the backend is not on port 8000.
#
# Vite exposes only `VITE_`-prefixed variables to the browser, and inlines them at
# build time, so nothing secret belongs in this file - the browser can read all of
# it. The real `.env.local` is gitignored; only this example is committed.
#
# This must match the backend's CORS_ORIGIN, which allows http://localhost:5173.
VITE_API_URL=http://localhost:8000
