# Copy to .env, replace placeholders, and keep the real file uncommitted.

NODE_ENV=development
PORT=8000

# Allowed browser origins; separate multiple values with commas.
CORS_ORIGIN=http://localhost:5173

# Create this database before running migrations.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tesla_pool
DB_USER=postgres
DB_PASSWORD=postgres

# Use different random signing keys for access and refresh tokens.
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string

ACCESS_TOKEN_EXPIRE=15m
REFRESH_TOKEN_EXPIRE=7d

# Production disables response stack traces and requires HTTPS for refresh cookies.
