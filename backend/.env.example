# Copy to .env and fill in. Never commit the real .env.
#
# The app checks this file at boot and refuses to start if any required value is
# missing, so a mistake here fails immediately with a clear message instead of
# at the first request.

# --- Server ---
NODE_ENV=development
PORT=8000

# Origin allowed to call this API. Comma-separate for several.
# There is no frontend yet, so this only matters once one exists.
CORS_ORIGIN=http://localhost:5173

# --- Database ---
# The database must already exist. `npm run migrate` creates the tables inside
# it but cannot create the database itself, so on a fresh machine:
#   createdb tesla_pool
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tesla_pool
DB_USER=postgres
DB_PASSWORD=postgres

# --- Auth ---
# These two are required and must be different from each other: the access and
# refresh tokens are signed independently, and sharing a key would mean a
# refresh token could be replayed as an access token.
#
# The values below are placeholders so the file is safe to commit. Generate real
# ones for anything other than local development:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string

# Token lifetimes. ACCESS_TOKEN_EXPIRE is deliberately short so that a
# leaked access token stops working quickly; the refresh token is what keeps
# the session alive, and it is revoked on logout.
ACCESS_TOKEN_EXPIRE=15m
REFRESH_TOKEN_EXPIRE=7d

# --- Notes ---
# NODE_ENV=development includes a stack trace in error responses, which is
# useful locally and must not happen in production. Setting it to production
# also marks the refresh cookie `secure`, so it is only sent over HTTPS.
