# Copy to .env, replace placeholders, and keep the real file uncommitted.

NODE_ENV=development
PORT=8000

# Allowed browser origins; separate multiple values with commas.
CORS_ORIGIN=http://localhost:5173

# Create this database before running migrations.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tesla_pool
DB_USER=postgres
DB_PASSWORD=postgres

# Set true for Neon; leave false for local PostgreSQL without TLS.
DB_SSL=false

# --- Auth ---
# These two are required and must be different from each other: the access and
# refresh tokens are signed independently, and sharing a key would mean a
# refresh token could be replayed as an access token.
#
# The values below are placeholders so the file is safe to commit. Generate real
# ones for anything other than local development:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string

ACCESS_TOKEN_EXPIRE=15m
REFRESH_TOKEN_EXPIRE=7d

# Production disables response stack traces and requires HTTPS for refresh cookies.
